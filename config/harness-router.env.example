# Optional Agent Harness overrides. CCR owns provider URLs, API keys, gateway
# authentication, and Claude model-discovery variables; do not copy them here.

# Enabled Claude Code profile name or id from CCR Agent Profiles.
AGENT_HARNESS_CCR_PROFILE=default-claude-code

# Set to 0 only when you start CCR yourself.
AGENT_HARNESS_START_CCR=1
