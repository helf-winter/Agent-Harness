# Copy this file to ~/.config/agent-harness/harness-router.env if your CCR
# gateway does not use the defaults below. Never commit real client keys.

# Claude Code Router gateway used by Agent Harness.
AGENT_HARNESS_CCR_BASE_URL=http://127.0.0.1:3456

# Optional CCR client API key. Older local CCR configurations may not require
# a real key; newer configurations should use a key created in the CCR UI.
AGENT_HARNESS_CCR_AUTH_TOKEN=

# Set to 0 only when you start CCR yourself.
AGENT_HARNESS_START_CCR=1
