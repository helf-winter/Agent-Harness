{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/experience.schema.json",
  "title": "Agent Harness Experience",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "experienceId", "version", "fingerprint", "status", "polarity",
    "title", "source", "context", "applicability", "exclusions", "strategy", "avoid",
    "confidence", "usageCount", "lastValidatedAt", "conflictExperienceIds",
    "supersedesExperienceIds", "createdAt", "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "experienceId": { "type": "string", "pattern": "^exp_" },
    "version": { "type": "integer", "minimum": 1 },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "enum": ["candidate", "usable", "deprecated"] },
    "polarity": { "enum": ["positive", "negative"] },
    "title": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["traceIds", "caseIds", "evidenceEventIds"],
      "properties": {
        "traceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "caseIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "evidenceEventIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["taskType", "projectType", "technologies"],
      "properties": {
        "taskType": { "const": "typescript-reproducible-test-repair" },
        "projectType": { "const": "node-package" },
        "technologies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "applicability": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "exclusions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "strategy": { "type": "string", "minLength": 1 },
    "avoid": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "usageCount": { "type": "integer", "minimum": 0 },
    "lastValidatedAt": { "type": "string", "format": "date-time" },
    "conflictExperienceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "supersedesExperienceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
