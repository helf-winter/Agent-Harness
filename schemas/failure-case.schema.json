{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/failure-case.schema.json",
  "title": "Agent Harness Failure Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "caseId", "fingerprint", "title", "status", "split",
    "classification", "taskType", "source", "reproductionOracle",
    "solutionOracle", "tags", "createdAt", "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "caseId": { "type": "string", "pattern": "^case_" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["raw", "triaged", "reproducible", "approved", "active", "deprecated"] },
    "split": { "enum": ["development", "validation", "regression", "holdout", "resilience"] },
    "classification": { "enum": ["capability", "workflow", "tool", "infrastructure", "environment", "requirement", "unknown"] },
    "taskType": { "const": "typescript-reproducible-test-repair" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "traceId", "taskId", "evidenceEventIds", "commitSha", "workingTreePatch"],
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "traceId": { "type": "string", "minLength": 1 },
        "taskId": { "type": "string", "minLength": 1 },
        "evidenceEventIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "workingTreePatch": { "type": "string" }
      }
    },
    "reproductionOracle": { "$ref": "#/$defs/oracle" },
    "solutionOracle": { "$ref": "#/$defs/oracle" },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "args", "timeoutMs", "expectedExitCode"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "expectedExitCode": { "type": "integer" },
        "outputIncludes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
