{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/skill.schema.json",
  "title": "Agent Harness Skill",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "skillId", "version", "fingerprint", "name", "description", "status",
    "source", "trigger", "preconditions", "inputContract", "outputContract", "steps",
    "permissions", "qualityGates", "failureHandling", "environment", "provenance", "baseline",
    "markdown", "createdAt", "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "skillId": { "type": "string", "pattern": "^skill_" },
    "version": { "type": "integer", "minimum": 1 },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "description": { "type": "string", "minLength": 1 },
    "status": { "enum": ["testing", "completed", "quarantined", "deprecated", "rejected"] },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["experienceIds", "traceIds", "caseIds"],
      "properties": {
        "experienceIds": { "$ref": "#/$defs/stringArrayNonempty" },
        "traceIds": { "$ref": "#/$defs/stringArrayNonempty" },
        "caseIds": { "$ref": "#/$defs/stringArray" }
      }
    },
    "trigger": {
      "type": "object", "additionalProperties": false,
      "required": ["taskTypes", "technologies", "conditions", "exclusions"],
      "properties": {
        "taskTypes": { "$ref": "#/$defs/stringArrayNonempty" },
        "technologies": { "$ref": "#/$defs/stringArrayNonempty" },
        "conditions": { "$ref": "#/$defs/stringArrayNonempty" },
        "exclusions": { "$ref": "#/$defs/stringArray" }
      }
    },
    "preconditions": { "$ref": "#/$defs/stringArrayNonempty" },
    "inputContract": { "type": "string", "minLength": 1 },
    "outputContract": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "instruction", "allowedTools", "completionEvidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "instruction": { "type": "string", "minLength": 1 },
          "allowedTools": { "$ref": "#/$defs/stringArrayNonempty" },
          "completionEvidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "permissions": {
      "type": "object", "additionalProperties": false,
      "required": ["tools", "destructiveOperations", "network"],
      "properties": {
        "tools": { "$ref": "#/$defs/stringArrayNonempty" },
        "destructiveOperations": { "const": false },
        "network": { "const": false }
      }
    },
    "qualityGates": { "$ref": "#/$defs/stringArrayNonempty" },
    "failureHandling": { "$ref": "#/$defs/stringArrayNonempty" },
    "environment": { "$ref": "#/$defs/stringArrayNonempty" },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["creator", "generator", "generatedAt"],
      "properties": {
        "creator": { "type": "string", "minLength": 1 },
        "generator": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["validationRunIds", "successRate", "medianDurationMs"],
      "properties": {
        "validationRunIds": { "$ref": "#/$defs/stringArray" },
        "successRate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "medianDurationMs": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "markdown": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "stringArray": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "stringArrayNonempty": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
