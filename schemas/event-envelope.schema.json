{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/event-envelope.schema.json",
  "title": "Harness Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "occurredAt",
    "recordedAt",
    "runtimeInstanceId",
    "correlationId",
    "actor",
    "source",
    "policyVersion",
    "redaction",
    "payload"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "eventId": { "type": "string", "minLength": 1 },
    "eventType": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "runtimeInstanceId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "relatedTaskIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "traceId": { "type": "string", "minLength": 1 },
    "turnId": { "type": "string", "minLength": 1 },
    "stageId": { "type": "string", "minLength": 1 },
    "stepId": { "type": "string", "minLength": 1 },
    "attemptId": { "type": "string", "minLength": 1 },
    "modelCallId": { "type": "string", "minLength": 1 },
    "toolCallId": { "type": "string", "minLength": 1 },
    "causationId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "enum": ["user", "agent", "controller", "hook", "worker", "grader", "system"]
        },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "adapterVersion"],
      "properties": {
        "adapter": { "type": "string", "minLength": 1 },
        "adapterVersion": { "type": "string", "minLength": 1 }
      }
    },
    "policyVersion": { "type": "string", "minLength": 1 },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rulesVersion", "redactedFields"],
      "properties": {
        "status": { "enum": ["applied", "not_required"] },
        "rulesVersion": { "type": "string", "minLength": 1 },
        "redactedFields": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "payload": { "type": "object" },
    "artifactRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "mediaType", "size"],
        "properties": {
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "mediaType": { "type": "string", "minLength": 1 },
          "size": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
